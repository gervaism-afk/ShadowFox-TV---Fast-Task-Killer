<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/screen_bg"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="16dp"
    android:paddingBottom="18dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="52" android:orientation="horizontal">
        <LinearLayout android:id="@+id/headerCard" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="42" android:gravity="center" android:orientation="vertical" android:paddingEnd="16dp">
            <ImageView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:adjustViewBounds="true" android:contentDescription="@string/app_name" android:scaleType="fitCenter" android:src="@drawable/shadowfox_logo" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.32" android:text="@string/subtitle" android:textColor="@color/blue2" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:letterSpacing="0.18" android:text="CLEANER  •  FASTER  •  SMOOTHER" android:textColor="@color/white" android:textSize="9sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:id="@+id/statusCard" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="58" android:background="@drawable/panel_card" android:orientation="vertical" android:padding="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="44" android:gravity="center_vertical" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DEVICE" android:textColor="@color/muted" android:textSize="10sp" />
                    <TextView android:id="@+id/deviceText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="ANDROID TV" android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical|end" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="UPTIME" android:textColor="@color/muted" android:textSize="10sp" />
                    <TextView android:id="@+id/uptimeText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="—" android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/blue1" android:alpha="0.45" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="56" android:orientation="horizontal" android:paddingTop="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CPU" android:textColor="@color/muted" android:textSize="9sp" /><TextView android:id="@+id/cpuText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="ACTIVE" android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold" /></LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.25" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RAM" android:textColor="@color/muted" android:textSize="9sp" /><TextView android:id="@+id/ramUsageText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="—" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" /></LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.25" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="STORAGE" android:textColor="@color/muted" android:textSize="9sp" /><TextView android:id="@+id/storageUsageText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="—" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" /></LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="APPS" android:textColor="@color/muted" android:textSize="9sp" /><TextView android:id="@+id/runningAppsText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="—" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" /></LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="18" android:gravity="center" android:orientation="vertical" android:paddingTop="6dp" android:paddingBottom="4dp">
        <Button android:id="@+id/cleanButton" android:layout_width="480dp" android:layout_height="58dp" android:background="@drawable/button_primary_tv" android:focusable="true" android:nextFocusDown="@id/rescanButton" android:text="@string/clean_now" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:id="@+id/summaryText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/ready" android:textColor="@color/white" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:id="@+id/detectedAppsText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/scanning_apps" android:textColor="@color/blue2" android:textSize="9sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="21" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="6dp" android:paddingBottom="6dp" android:clipChildren="false" android:clipToPadding="false">
        <Button android:id="@+id/rescanButton" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/button_secondary_tv" android:focusable="true" android:nextFocusUp="@id/cleanButton" android:nextFocusRight="@id/appListButton" android:text="RESCAN" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
        <Button android:id="@+id/appListButton" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:background="@drawable/button_secondary_tv" android:focusable="true" android:nextFocusLeft="@id/rescanButton" android:nextFocusRight="@id/settingsButton" android:nextFocusUp="@id/cleanButton" android:text="APP LIST" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
        <Button android:id="@+id/settingsButton" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:background="@drawable/button_secondary_tv" android:focusable="true" android:nextFocusLeft="@id/appListButton" android:nextFocusRight="@id/systemInfoButton" android:nextFocusUp="@id/cleanButton" android:text="SETTINGS" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
        <Button android:id="@+id/systemInfoButton" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:background="@drawable/button_secondary_tv" android:focusable="true" android:nextFocusLeft="@id/settingsButton" android:nextFocusRight="@id/aboutButton" android:nextFocusUp="@id/cleanButton" android:text="SYSTEM INFO" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" />
        <Button android:id="@+id/aboutButton" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:layout_marginStart="6dp" android:background="@drawable/button_secondary_tv" android:focusable="true" android:nextFocusLeft="@id/systemInfoButton" android:nextFocusUp="@id/cleanButton" android:text="ABOUT" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="9" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/websiteText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/website" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.16" android:text="OPTIMIZE YOUR ANDROID TV EXPERIENCE" android:textColor="@color/white" android:textSize="8sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:id="@+id/resultCard" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone">
        <TextView android:id="@+id/appsCleanedText" android:layout_width="1dp" android:layout_height="1dp" />
        <TextView android:id="@+id/ramRecoveredText" android:layout_width="1dp" android:layout_height="1dp" />
        <TextView android:id="@+id/storageRecoveredText" android:layout_width="1dp" android:layout_height="1dp" />
    </LinearLayout>
</LinearLayout>
