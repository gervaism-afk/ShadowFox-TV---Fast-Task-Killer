<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/screen_bg"
    android:paddingStart="28dp"
    android:paddingEnd="42dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/headerCard"
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/panel_card"
        android:paddingStart="16dp"
        android:paddingEnd="20dp">

        <ImageView
            android:layout_width="94dp"
            android:layout_height="70dp"
            android:src="@drawable/shadowfox_logo"
            android:scaleType="fitCenter"
            android:contentDescription="@string/app_name" />

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/title" android:textColor="@color/white" android:textSize="27sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="@string/subtitle" android:textColor="@color/blue2" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/version_short" android:textColor="@color/muted" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:weightSum="100">

        <LinearLayout
            android:id="@+id/statusCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="42"
            android:layout_marginEnd="7dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:background="@drawable/panel_card"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/system_status" android:textColor="@color/blue2" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/summaryText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/ready" android:textColor="@color/white" android:textSize="27sp" android:textStyle="bold" />
            <TextView android:id="@+id/detectedAppsText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/scanning_apps" android:textColor="@color/blue2" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/protected_note" android:textColor="@color/muted" android:textSize="10sp" />
            <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
            <Button android:id="@+id/rescanButton" android:layout_width="190dp" android:layout_height="46dp" android:background="@drawable/button_secondary_tv" android:text="@string/rescan" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" android:focusable="true" android:nextFocusRight="@id/cleanButton" android:nextFocusUp="@id/cleanButton" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="58" android:layout_marginStart="7dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/panel_card" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="10dp" android:paddingBottom="10dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/cleanup_heading" android:textColor="@color/muted" android:textSize="10sp" android:textStyle="bold" />
                <Button android:id="@+id/cleanButton" android:layout_width="match_parent" android:layout_height="78dp" android:layout_marginTop="7dp" android:background="@drawable/button_primary_tv" android:text="@string/clean_now" android:textColor="@color/white" android:textSize="27sp" android:textStyle="bold" android:focusable="true" android:nextFocusLeft="@id/rescanButton" android:nextFocusDown="@id/rescanButton" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:text="@string/clean_hint" android:textColor="@color/muted" android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/resultCard" android:layout_width="match_parent" android:layout_height="104dp" android:layout_marginTop="10dp" android:orientation="horizontal" android:weightSum="3" android:visibility="visible">
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="5dp" android:background="@drawable/stat_tile" android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/appsCleanedText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="—" android:textColor="@color/white" android:textSize="25sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center" android:text="@string/apps_processed" android:textColor="@color/muted" android:textSize="9sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" android:background="@drawable/stat_tile" android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/ramRecoveredText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="—" android:textColor="@color/blue2" android:textSize="25sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center" android:text="@string/ram_recovered" android:textColor="@color/muted" android:textSize="9sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:background="@drawable/stat_tile" android:gravity="center" android:orientation="vertical" android:paddingStart="6dp" android:paddingEnd="6dp">
                    <TextView android:id="@+id/storageRecoveredText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/storage_restricted" android:textColor="@color/muted" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center" android:text="@string/storage_status" android:textColor="@color/muted" android:textSize="9sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/footer_note" android:textColor="@color/muted" android:textSize="9sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/website" android:textColor="@color/blue2" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
