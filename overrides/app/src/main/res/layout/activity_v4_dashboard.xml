<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/screen_bg">

    <LinearLayout
        android:id="@+id/commandCenterPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="18dp"
        android:paddingBottom="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:contentDescription="@string/app_name"
                android:src="@drawable/shadowfox_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.15"
                android:orientation="vertical"
                android:background="@drawable/tech_panel"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SHADOWFOX COMMAND CENTER"
                    android:textColor="@color/blue2"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:letterSpacing="0.12" />

                <TextView
                    android:id="@+id/deviceTextV4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="ANDROID TV"
                    android:textColor="@color/white"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/rootTextV4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="STANDARD MODE"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/networkTextV4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ONLINE"
                        android:textColor="@color/blue2"
                        android:textStyle="bold"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="118dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/tech_stat_tile">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DEVICE HEALTH" android:textColor="@color/blue2" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/healthScoreText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="100" android:textColor="@color/white" android:textSize="34sp" android:textStyle="bold" />
                <TextView android:id="@+id/healthStateText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EXCELLENT" android:textColor="@color/blue2" android:textSize="9sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="118dp" android:layout_weight="1.35" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/tech_stat_tile">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RAM LOAD" android:textColor="@color/blue2" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/ramTextV4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="—" android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="118dp" android:layout_weight="1.35" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/tech_stat_tile">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="STORAGE" android:textColor="@color/blue2" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/storageTextV4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="—" android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="118dp" android:layout_weight="0.85" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/tech_stat_tile">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="APPS" android:textColor="@color/blue2" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/appsTextV4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="0" android:textColor="@color/white" android:textSize="28sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="118dp" android:layout_weight="1" android:layout_marginStart="6dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/tech_stat_tile">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="UPTIME" android:textColor="@color/blue2" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/uptimeTextV4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="—" android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:gravity="center">

            <Button
                android:id="@+id/optimizeButtonV4"
                android:layout_width="520dp"
                android:layout_height="60dp"
                android:background="@drawable/button_primary_tv"
                android:focusable="true"
                android:text="OPTIMIZE NOW"
                android:textColor="@color/white"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/resultTitleV4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="SYSTEM READY"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/resultDetailV4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Smart analysis • protected system apps • root-aware engine"
                android:textColor="@color/blue2"
                android:textStyle="bold"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="PREMIUM TOOLKIT"
            android:textColor="@color/blue2"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.14" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal">
            <Button android:id="@+id/appsButtonV4" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_marginEnd="5dp" android:background="@drawable/button_secondary_tv" android:focusable="true" android:text="APP MANAGER" android:textColor="@color/white" android:textStyle="bold" android:textSize="11sp" />
            <Button android:id="@+id/storageButtonV4" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" android:background="@drawable/button_secondary_tv" android:focusable="true" android:text="STORAGE TOOLS" android:textColor="@color/white" android:textStyle="bold" android:textSize="11sp" />
            <Button android:id="@+id/networkButtonV4" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" android:background="@drawable/button_secondary_tv" android:focusable="true" android:text="NETWORK TOOLS" android:textColor="@color/white" android:textStyle="bold" android:textSize="11sp" />
            <Button android:id="@+id/rootButtonV4" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_marginStart="5dp" android:background="@drawable/button_secondary_tv" android:focusable="true" android:text="ROOT MODE" android:textColor="@color/white" android:textStyle="bold" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <Button android:id="@+id/reportButtonV4" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginEnd="5dp" android:background="@drawable/button_secondary_tv" android:focusable="true" android:text="HEALTH REPORT" android:textColor="@color/white" android:textStyle="bold" android:textSize="10sp" />
            <Button android:id="@+id/updateButtonV4" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" android:background="@drawable/button_secondary_tv" android:focusable="true" android:text="UPDATE CENTER" android:textColor="@color/white" android:textStyle="bold" android:textSize="10sp" />
            <Button android:id="@+id/settingsButtonV4" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" android:background="@drawable/button_secondary_tv" android:focusable="true" android:text="SYSTEM SETTINGS" android:textColor="@color/white" android:textStyle="bold" android:textSize="10sp" />
            <Button android:id="@+id/aboutButtonV4" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginStart="5dp" android:background="@drawable/button_secondary_tv" android:focusable="true" android:text="ABOUT" android:textColor="@color/white" android:textStyle="bold" android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="www.shadowfoxtv.ca" android:textColor="@color/white" android:textStyle="bold" android:textSize="10sp" />
            <TextView android:id="@+id/versionTextV4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="v4.0.0 • SYSTEM OPTIMIZER EDITION" android:textColor="@color/blue2" android:textStyle="bold" android:textSize="9sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
